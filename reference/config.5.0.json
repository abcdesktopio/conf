  "dock": {
    "webshell": {
      "name": "WebShell",
      "acl": {
        "permit": [
          "all"
        ]
      },
      "keyword": "terminal,shell,webshell,bash,cmd",
      "showinview": "dock",
      "launch": "frontendjs.webshell",
      "displayname": "Web Shell",
      "execmode": "frontendjs",
      "cat": "utilities,development",
      "id": "webshell.d",
      "icon": "webshell.svg"
    }
